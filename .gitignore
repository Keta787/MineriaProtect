.ipynb_checkpoints/
__pycache__/
*.pyc
.DS_Store

# ============================================================
# ARCHIVOS GRANDES - REGLA DEL PROYECTO: NO SUBIR A GIT SI
# EL ARCHIVO SUPERA LOS 50 MB (límite GitHub por archivo: 100 MB).
# ============================================================
# data/03_processed/*.csv pesan 156-184 MB cada uno (>100 MB = limite
# duro de GitHub) -> NO se versionan. Solo se sube la estructura
# de la carpeta mediante .gitkeep (los CSV se regeneran localmente
# ejecutando src/limpieza/*.py sobre data/01_raw/).
data/03_processed/*
!data/03_processed/.gitkeep

# bitácora de ejecución de los pipelines (trazabilidad en ejecución)
logs/

# Contextos de sesión (solo se conservan en disco, no se versionan)
contexto_sesion*.md

# Metodología KDD/CRISP-DM (solo en disco, no se versiona; igual que contextos)
METODOLOGIA_KDD_CRISPDM.md

# Versión local de Python (solo en disco; la referencia queda en requirements.txt)
.python-version